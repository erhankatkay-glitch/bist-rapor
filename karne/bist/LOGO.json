olar":[{"ad":"İyimser","fiyat":130.558,"kosul":"121,21 direnci aşılır, yükseliş sinyalleri teyit edilir","degisim":0.102689},{"ad":"Baz","fiyat":115.36,"kosul":"mevcut görünüm (SAT) sürer, fiyat bant içinde hareket eder","degisim":-0.0256724},{"ad":"Kötümser","fiyat":106.242,"kosul":"110,26 desteği kırılır, satış baskısı artar","degisim":-0.102689}],"tez_bozucular":["Günlük kapanış 107,76 ₺ altına inerse (en yakın destek 110,26 kırılır) yükseliş tezi bozulur.","Günlük kapanış 123,71 ₺ üstüne çıkarsa (direnç 121,21 aşılır) düşüş tezi bozulur.","Haftalık görünüm şu an SAT; AL bölgesine dönerse orta vade tezi değişir.","Piyasa rejimi şu an 'Düzeltme'; 'Düzeltme'ye geçerse yeni alımlar için ortam bozulur."],"roller":[{"rol":"arastirmaci","ad":"Yatırım araştırmacısı","ilke":"Boğa ve ayı senaryosu eşit titizlikte; tez ölçülebilir olmalı, tez bozucular önceden yazılır.","bulgular":["Ufuk: Kısa–orta vade (2–6 hafta), günlük ve haftalık grafik.","Boğa tezi: Cımbız dip; MACD al kesişimi.","Ayı tezi: İkili tepe – oluşumda; Ichimoku Tenkan/Kijun sat kesişimi."]},{"rol":"analist","ad":"Finansal analist","ilke":"Önce varsayımlar; tek nokta tahmin yok, baz/iyimser/kötümser senaryo; olgu ile tahmin ayrı.","bulgular":["Varsayımlar: Günlük oynaklık son 1 yılın ortalaması (σ ≈ %2,30) gibi devam eder. 20 işlem günü ufkunda 1 standart sapma bandı kullanılır (%68 olasılık; kesinlik değildir). Destek/direnç geçmiş fiyat yığılmalarından hesaplanır; haber ve bilanço sürprizleri modele dahil değildir.","Senaryolar (20 gün): İyimser 130,56 ₺ (+%10,3): 121,21 direnci aşılır, yükseliş sinyalleri teyit edilir · Baz 115,36 ₺ (-%2,6): mevcut görünüm (SAT) sürer, fiyat bant içinde hareket eder · Kötümser 106,24 ₺ (-%10,3): 110,26 desteği kırılır, satış baskısı artar.","Oynaklık %15 yüksek varsayılırsa kötümser senaryo -%11,8 olur; sonuç tablosu bu farka dayanıklı değilse güven düşük okunmalı.","Olgu: son fiyat ve geçmiş göstergeler. Tahmin: senaryo fiyatları — ikisi karıştırılmamalı."]},{"rol":"istatistikci","ad":"İstatistikçi","ilke":"Anlamlılık önem değildir; sonuç aralıkla verilir; az örnek 'bilemiyoruz' demektir; çok deneme yanlış pozitif üretir.","bulgular":["Bu varlığın kendi geçmişinde 127 kurulum olayı (9 farklı kurulum): ortalama +0,31R, %95 güven aralığı [+0,14, +0,49]R; kanıt gücü makul.","Not: 4 gösterge/kurulum birlikte tarandı; tek bir sinyalin öne çıkması şans eseri olabilir. Göstergeler ilişki gösterir, nedensellik değil."]},{"rol":"test","ad":"Test sonuçları analisti","ilke":"Başarısız sinyaller de raporlanır; isabet oranı ve ortalama sonuç birlikte okunur.","bulgular":["Son 8 kurulumun sonucu (kazananlar ve kaybedenler):","22.09.2026 · Hacimli kırılım · kazandı (+0,33R, hedef alındı, kalanı başabaşta kapandı)","10.09.2026 · Sıkışma kırılımı · kaybetti (-1,00R, stop oldu)","10.09.2026 · Hacimli kırılım · kaybetti (-1,00R, stop oldu)","30.07.2026 · Harmonik dönüş · kazandı (+0,50R, hedef alındı, kalanı başabaşta kapandı)","22.05.2026 · Harmonik dönüş · kazandı (+0,50R, hedef alındı, kalanı başabaşta kapandı)","04.05.2026 · Hacimli kırılım · kazandı (+1,10R, hedef alındı, kalanı başabaşta kapandı)","17.04.2026 · Hacimli kırılım · kaybetti (-1,00R, stop oldu)","16.04.2026 · Sıkışma kırılımı · kazandı (+1,70R, 3. hedefe ulaştı)","İsabet oranı %64, en kötü sonuç -1,00R."]},{"rol":"risk","ad":"Risk yöneticisi","ilke":"En kötü durum rakamla: stop gelirse kayıp, geçmiş en kötü günler (VaR), en büyük düşüş.","bulgular":["Alım pozisyonu için stop 107,76 ₺ (en yakın destek − 0,5 ATR) gelirse kayıp -%9,0 → 10.000 TL'lik pozisyonda ≈ 899 TL.","Geçmiş 1 yılın en kötü %5'lik günlerinde kayıp -%3,4 (343 TL), en kötü %1'de -%5,3; 10 günlük %5 VaR -%10,4.","Son 1 yılın en kötü günü -%7,3, en büyük düşüş -%33,7.","Piyasa rejimi önerisi: portföyde en çok %0 hisse (Düzeltme)."]},{"rol":"denetci","ad":"Gerçeklik denetçisi","ilke":"Varsayılan tutum şüphecilik; çelişki ve veri sorunu varsa güven düşer, kusursuz görünüm kırmızı bayraktır.","bulgular":["Belirgin çeliş