,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null]},"gun":{"yuksek":23.9,"dusuk":23.18},"ekip":{"kod":"MAIR.US","ad":"Madison Air Solutions Corporation Class A Common Stock","fiyat":23.52,"para":"$","gorunum":"AL eğilimli (kanıt zayıf)","guven":"Düşük","ufuk":"Kısa–orta vade (2–6 hafta), günlük ve haftalık grafik","senaryolar":[{"ad":"İyimser","fiyat":27.2485,"kosul":"24,50 direnci aşılır, yükseliş sinyalleri teyit edilir","degisim":0.158523},{"ad":"Baz","fiyat":24.4521,"kosul":"mevcut görünüm (AL) sürer, fiyat bant içinde hareket eder","degisim":0.0396308},{"ad":"Kötümser","fiyat":19.7915,"kosul":"22,85 desteği kırılır, satış baskısı artar","degisim":-0.158523}],"tez_bozucular":["Günlük kapanış 22,18 $ altına inerse (en yakın destek 22,85 kırılır) yükseliş tezi bozulur.","Günlük kapanış 25,17 $ üstüne çıkarsa (direnç 24,50 aşılır) düşüş tezi bozulur.","Haftalık görünüm şu an GÜÇLÜ SAT; AL bölgesine dönerse orta vade tezi değişir.","Piyasa rejimi şu an 'Ralli denemesi'; 'Düzeltme'ye geçerse yeni alımlar için ortam bozulur."],"roller":[{"rol":"arastirmaci","ad":"Yatırım araştırmacısı","ilke":"Boğa ve ayı senaryosu eşit titizlikte; tez ölçülebilir olmalı, tez bozucular önceden yazılır.","bulgular":["Ufuk: Kısa–orta vade (2–6 hafta), günlük ve haftalık grafik.","Boğa tezi: Sabah yıldızı; İkili dip – oluşumda; Dışarıda çubuk (outside bar); MACD al kesişimi.","Ayı tezi: Ichimoku Tenkan/Kijun sat kesişimi."]},{"rol":"analist","ad":"Finansal analist","ilke":"Önce varsayımlar; tek nokta tahmin yok, baz/iyimser/kötümser senaryo; olgu ile tahmin ayrı.","bulgular":["Varsayımlar: Günlük oynaklık son 1 yılın ortalaması (σ ≈ %3,54) gibi devam eder. 20 işlem günü ufkunda 1 standart sapma bandı kullanılır (%68 olasılık; kesinlik değildir). Destek/direnç geçmiş fiyat yığılmalarından hesaplanır; haber ve bilanço sürprizleri modele dahil değildir.","Senaryolar (20 gün): İyimser 27,25 $ (+%15,9): 24,50 direnci aşılır, yükseliş sinyalleri teyit edilir · Baz 24,45 $ (+%4,0): mevcut görünüm (AL) sürer, fiyat bant içinde hareket eder · Kötümser 19,79 $ (-%15,9): 22,85 desteği kırılır, satış baskısı artar.","Oynaklık %15 yüksek varsayılırsa kötümser senaryo -%18,2 olur; sonuç tablosu bu farka dayanıklı değilse güven düşük okunmalı.","Olgu: son fiyat ve geçmiş göstergeler. Tahmin: senaryo fiyatları — ikisi karıştırılmamalı."]},{"rol":"istatistikci","ad":"İstatistikçi","ilke":"Anlamlılık önem değildir; sonuç aralıkla verilir; az örnek 'bilemiyoruz' demektir; çok deneme yanlış pozitif üretir.","bulgular":["Bu varlığın kendi geçmişinde 7 kurulum olayı (3 farklı kurulum): ortalama -0,36R, %95 güven aralığı [-0,95, +0,24]R; kanıt gücü zayıf (az örnek).","Güven aralığı sıfırı kapsıyor: bu varlıkta kurulumların kazandırdığı istatistiksel olarak gösterilemiyor (\"bilemiyoruz\").","Not: 6 gösterge/kurulum birlikte tarandı; tek bir sinyalin öne çıkması şans eseri olabilir. Göstergeler ilişki gösterir, nedensellik değil."]},{"rol":"test","ad":"Test sonuçları analisti","ilke":"Başarısız sinyaller de raporlanır; isabet oranı ve ortalama sonuç birlikte okunur.","bulgular":["Son 7 kurulumun sonucu (kazananlar ve kaybedenler):","03.11.2026 · Momentum patlaması · kaybetti (-1,00R, stop oldu)","27.10.2026 · Pozitif uyumsuzluklu dönüş · kaybetti (-1,00R, stop oldu)","22.10.2026 · Likidite avı dönüşü · kazandı (+0,50R, hedef alındı, kalanı başabaşta kapandı)","15.10.2026 · Likidite avı dönüşü · kazandı (+0,50R, hedef alındı, kalanı başabaşta kapandı)","22.09.2026 · Pozitif uyumsuzluklu dönüş · kaybetti (-1,00R, stop oldu)","11.09.2026 · Pozitif uyumsuzluklu dönüş · kaybetti (-1,00R, stop oldu)","16.07.2026 · Likidite avı dönüşü · kazandı (+0,50R, hedef alındı, kalanı başabaşta kapandı)","İsabet oranı %43, en kötü sonuç -1,00R."]},{"rol":"risk","ad":"Risk yöneticisi","ilke":"En kötü durum rakamla: stop gelirse kayıp, geçmiş en kötü günler (VaR), en büyük düşüş.","bulgular":["Alım pozisyonu için stop 22,18 $ (en yakın destek − 0,5 ATR) gelirse kayıp -%5,7 → 10.000 $'lik pozisyonda ≈ 568 $.","Geçmiş 1 yılın en kötü %5'lik günlerinde kayıp -%6,4 (644 $), en kötü %1'de -%8,0; 10 günlük %5 VaR -%19,0.","Son 1 yılın en kötü günü -%9,3, en büyük düşüş -%51,2.","Piyasa rejimi önerisi: portföyde en çok %30 hisse (Ralli denemesi)."]},{"rol":"denetci","ad":"Gerçeklik denetçisi","ilke":"Varsayılan tutum şüphecilik; çelişki ve veri sorunu varsa güven düşer, kusursuz görünüm kırmızı bayraktır.","bulgular":["Zaman dilimleri çelişiyor (AL / GÜÇLÜ SAT).","Teknik görünüm AL ama piyasa rejimi 'Ralli denemesi'.","Güven derecesi: Düşük."]}],"risk":{"stop":22.1844,"kayip":0.0567864,"sigma_g":0.0354469,"var95":-0.0644188,"var99":-0.0798997,"var95_10":-0.189876,"en_kotu_gun":-0.0927573,"maks_dusus_1y":-0.511628},"gecmis":{"n":7,"isabet":0.428571,"ort_R":-0.357143,"ga":[-0.951113,0.236827],"en_kotu":-1.0,"olaylar":[{"tarih":"2026-07-16 00:00","kurulum":"Likidite avı dönüşü","yon":1,"R":0.5,"asama":1,"sebep":"başabaş"},{"tarih":"2026-09-11 00:00","kurulum":"Pozitif uyumsuzluklu dönüş","yon":1,"R":-1.0,"asama":0,"sebep":"stop"},{"tarih":"2026-09-22 00:00","kurulum":"Pozitif uyumsuzluklu dönüş","yon":1,"R":-1.0,"asama":0,"sebep":"stop"},{"tarih":"2026-10-15 00:00","kurulum":"Likidite avı dönüşü","yon":1,"R":0.5,"asama":1,"sebep":"başabaş"},{"tarih":"2026-10-22 00:00","kurulum":"Likidite avı dönüşü","yon":1,"R":0.5,"asama":1,"sebep":"başabaş"},{"tarih":"2026-10-27 00:00","kurulum":"Pozitif uyumsuzluklu dönüş","yon":1,"R":-1.0,"asama":0,"sebep":"stop"},{"tarih":"2026-11-03 00:00","kurulum":"Momentum patlaması","yon":1,"R":-1.0,"asama":0,"sebep":"stop"}],"kurulum_sayisi":3},"ozet":"AL eğilimli (kanıt zayıf) · güven düşük · ufuk 2–6 hafta. Kötümser senaryoda -%15,9, stop gelirse -%5,7.","uyari":"Kural tabanlı otomatik değerlendirmedir; yatırım tavsiyesi değildir."}}