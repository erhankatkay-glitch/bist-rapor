78.835,78.8693,78.9135,78.9624,79.013,79.0628,79.1218,79.1758,79.2382,79.292,79.3393,79.3872,79.4341,79.4744,79.5114,79.5325,79.5173,79.5275,79.5271,79.5353,79.5541,79.572,79.5459,79.5184,79.4921,79.4729,79.4572,79.4326,79.404,79.3806,79.3586,79.3364,79.3163,79.3019]},"gun":{"yuksek":83.42,"dusuk":81.89},"ekip":{"kod":"SYY.US","ad":"Sysco Corporation Common Stock","fiyat":83.31,"para":"$","gorunum":"AL eğilimli (kanıt zayıf)","guven":"Düşük","ufuk":"Kısa–orta vade (2–6 hafta), günlük ve haftalık grafik","senaryolar":[{"ad":"İyimser","fiyat":90.3289,"kosul":"84,72 direnci aşılır, yükseliş sinyalleri teyit edilir","degisim":0.0842508},{"ad":"Baz","fiyat":85.0647,"kosul":"mevcut görünüm (GÜÇLÜ AL) sürer, fiyat bant içinde hareket eder","degisim":0.0210627},{"ad":"Kötümser","fiyat":76.2911,"kosul":"81,15 desteği kırılır, satış baskısı artar","degisim":-0.0842508}],"tez_bozucular":["Günlük kapanış 80,19 $ altına inerse (en yakın destek 81,15 kırılır) yükseliş tezi bozulur.","Günlük kapanış 85,68 $ üstüne çıkarsa (direnç 84,72 aşılır) düşüş tezi bozulur.","Haftalık görünüm şu an AL; SAT bölgesine dönerse orta vade tezi değişir.","Piyasa rejimi şu an 'Ralli denemesi'; 'Düzeltme'ye geçerse yeni alımlar için ortam bozulur."],"roller":[{"rol":"arastirmaci","ad":"Yatırım araştırmacısı","ilke":"Boğa ve ayı senaryosu eşit titizlikte; tez ölçülebilir olmalı, tez bozucular önceden yazılır.","bulgular":["Ufuk: Kısa–orta vade (2–6 hafta), günlük ve haftalık grafik.","Boğa tezi: İkili dip – TEYİT (boyun çizgisi kırıldı); Pivot SuperTrend al dönüşü; Yapı kırılımı yukarı (BOS); Gizli pozitif uyumsuzluk (MACD).","Ayı tezi: Asılı adam."]},{"rol":"analist","ad":"Finansal analist","ilke":"Önce varsayımlar; tek nokta tahmin yok, baz/iyimser/kötümser senaryo; olgu ile tahmin ayrı.","bulgular":["Varsayımlar: Günlük oynaklık son 1 yılın ortalaması (σ ≈ %1,88) gibi devam eder. 20 işlem günü ufkunda 1 standart sapma bandı kullanılır (%68 olasılık; kesinlik değildir). Destek/direnç geçmiş fiyat yığılmalarından hesaplanır; haber ve bilanço sürprizleri modele dahil değildir.","Senaryolar (20 gün): İyimser 90,33 $ (+%8,4): 84,72 direnci aşılır, yükseliş sinyalleri teyit edilir · Baz 85,06 $ (+%2,1): mevcut görünüm (GÜÇLÜ AL) sürer, fiyat bant içinde hareket eder · Kötümser 76,29 $ (-%8,4): 81,15 desteği kırılır, satış baskısı artar.","Oynaklık %15 yüksek varsayılırsa kötümser senaryo -%9,7 olur; sonuç tablosu bu farka dayanıklı değilse güven düşük okunmalı.","Olgu: son fiyat ve geçmiş göstergeler. Tahmin: senaryo fiyatları — ikisi karıştırılmamalı."]},{"rol":"istatistikci","ad":"İstatistikçi","ilke":"Anlamlılık önem değildir; sonuç aralıkla verilir; az örnek 'bilemiyoruz' demektir; çok deneme yanlış pozitif üretir.","bulgular":["Taze kurulumların piyasa geneli kanıtı: SuperTrend al dönüşü: piyasa genelinde 4938 olay, ortalama +0,06R, 1. hedefe ulaşma %31.","Bu varlığın kendi geçmişinde 105 kurulum olayı (9 farklı kurulum): ortalama -0,08R, %95 güven aralığı [-0,27, +0,11]R; kanıt gücü makul.","Güven aralığı sıfırı kapsıyor: bu varlıkta kurulumların kazandırdığı istatistiksel olarak gösterilemiyor (\"bilemiyoruz\").","Not: 9 gösterge/kurulum birlikte tarandı; tek bir sinyalin öne çıkması şans eseri olabilir. Göstergeler ilişki gösterir, nedensellik değil."]},{"rol":"test","ad":"Test sonuçları analisti","ilke":"Başarısız sinyaller de raporlanır; isabet oranı ve ortalama sonuç birlikte okunur.","bulgular":["Son 8 kurulumun sonucu (kazananlar ve kaybedenler):","12.08.2026 · Trend içi geri çekilme · kaybetti (-1,06R, stop oldu)","22.07.2026 · Trend içi geri çekilme · kazandı (+0,50R, hedef alındı, kalanı başabaşta kapandı)","16.07.2026 · Harmonik dönüş · kazandı (+0,50R, hedef alındı, kalanı başabaşta kapandı)","01.07.2026 · Kırıcı blok geri testi · kaybetti (-1,00R, stop oldu)","26.06.2026 · Hacimli kırılım · kazandı (+0,50R, hedef alındı, kalanı başabaşta kapandı)","09.03.2026 · Harmonik dönüş · kaybetti (-1,00R, stop oldu)","03.02.2026 · Kırıcı blok geri testi · kazandı (+0,88R, süre doldu)","27.01.2026 · Hacimli kırılım · kazandı (+0,93R, süre doldu)","İsabet oranı %47, en kötü sonuç -1,16R."]},{"rol":"risk","ad":"Risk yöneticisi","ilke":"En kötü durum rakamla: stop gelirse kayıp, geçmiş en kötü günler (VaR), en büyük düşüş.","bulgular":["Alım pozisyonu için stop 80,19 $ (en yakın destek − 0,5 ATR) gelirse kayıp -%3,7 → 10.000 $'lik pozisyonda ≈ 374 $.","Geçmiş 1 yılın en kötü %5'lik günlerinde kayıp -%2,1 (211 $), en kötü %1'de -%3,9; 10 günlük %5 VaR -%6,5.","Son 1 yılın en kötü günü -%15,3, en büyük düşüş -%24,0.","Piyasa rejimi önerisi: portföyde en çok %30 hisse (Ralli denemesi)."]},{"rol":"denetci","ad":"Gerçeklik denetçisi","ilke":"Varsayılan tutum şüphecilik; çelişki ve veri sorunu varsa güven düşer, kusursuz görünüm kırmızı bayraktır.","bulgular":["Teknik görünüm AL ama piyasa rejimi 'Ralli denemesi'.","Bu varlıkta kurulumların geçmiş ortalaması negatif.","Güven derecesi: Düşük."]}],"risk":{"stop":80.1907,"kayip":0.0374423,"sigma_g":0.0188391,"var95":-0.0211143,"var99":-0.0389354,"var95_10":-0.0652575,"en_kotu_gun":-0.152812,"maks_dusus_1y":-0.239798},"gecmis":{"n":105,"isabet":0.466667,"ort_R":-0.0821279,"ga":[-0.271147,0.106891],"en_kotu":-1.16053,"olaylar":[{"tarih":"2026-01-27 00:00","kurulum":"Hacimli kırılım","yon":1,"R":0.929619,"asama":1,"sebep":"süre"},{"tarih":"2026-02-03 00:00","kurulum":"Kırıcı blok geri testi","yon":1,"R":0.879372,"asama":1,"sebep":"süre"},{"tarih":"2026-03-09 00:00","kurulum":"Harmonik dönüş","yon":1,"R":-1.0,"asama":0,"sebep":"stop"},{"tarih":"2026-06-26 00:00","kurulum":"Hacimli kırılım","yon":1,"R":0.5,"asama":1,"sebep":"başabaş"},{"tarih":"2026-07-01 00:00","kurulum":"Kırıcı blok geri testi","yon":1,"R":-1.0,"asama":0,"sebep":"stop"},{"tarih":"2026-07-16 00:00","kurulum":"Harmonik dönüş","yon":1,"R":0.5,"asama":1,"sebep":"başabaş"},{"tarih":"2026-07-22 00:00","kurulum":"Trend içi geri çekilme","yon":1,"R":0.5,"asama":1,"sebep":"başabaş"},{"tarih":"2026-08-12 00:00","kurulum":"Tr