oller":[{"rol":"arastirmaci","ad":"Yatırım araştırmacısı","ilke":"Boğa ve ayı senaryosu eşit titizlikte; tez ölçülebilir olmalı, tez bozucular önceden yazılır.","bulgular":["Ufuk: Kısa–orta vade (2–6 hafta), günlük ve haftalık grafik.","Boğa tezi: Pivot direnci kırılımı; İkili dip – oluşumda; MACD al kesişimi.","Ayı tezi: SuperTrend sat sinyaline döndü."]},{"rol":"analist","ad":"Finansal analist","ilke":"Önce varsayımlar; tek nokta tahmin yok, baz/iyimser/kötümser senaryo; olgu ile tahmin ayrı.","bulgular":["Varsayımlar: Günlük oynaklık son 1 yılın ortalaması (σ ≈ %5,09) gibi devam eder. 20 işlem günü ufkunda 1 standart sapma bandı kullanılır (%68 olasılık; kesinlik değildir). Destek/direnç geçmiş fiyat yığılmalarından hesaplanır; haber ve bilanço sürprizleri modele dahil değildir.","Senaryolar (20 gün): İyimser 200,10 $ (+%22,8): 179,95 direnci aşılır, yükseliş sinyalleri teyit edilir · Baz 172,27 $ (+%5,7): mevcut görünüm (GÜÇLÜ AL) sürer, fiyat bant içinde hareket eder · Kötümser 125,88 $ (-%22,8): 159,25 desteği kırılır, satış baskısı artar.","Oynaklık %15 yüksek varsayılırsa kötümser senaryo -%26,2 olur; sonuç tablosu bu farka dayanıklı değilse güven düşük okunmalı.","Olgu: son fiyat ve geçmiş göstergeler. Tahmin: senaryo fiyatları — ikisi karıştırılmamalı."]},{"rol":"istatistikci","ad":"İstatistikçi","ilke":"Anlamlılık önem değildir; sonuç aralıkla verilir; az örnek 'bilemiyoruz' demektir; çok deneme yanlış pozitif üretir.","bulgular":["Bu varlığın kendi geçmişinde 99 kurulum olayı (8 farklı kurulum): ortalama -0,14R, %95 güven aralığı [-0,36, +0,08]R; kanıt gücü makul.","Güven aralığı sıfırı kapsıyor: bu varlıkta kurulumların kazandırdığı istatistiksel olarak gösterilemiyor (\"bilemiyoruz\").","Not: 4 gösterge/kurulum birlikte tarandı; tek bir sinyalin öne çıkması şans eseri olabilir. Göstergeler ilişki gösterir, nedensellik değil."]},{"rol":"test","ad":"Test sonuçları analisti","ilke":"Başarısız sinyaller de raporlanır; isabet oranı ve ortalama sonuç birlikte okunur.","bulgular":["Son 8 kurulumun sonucu (kazananlar ve kaybedenler):","06.11.2026 · Kırıcı blok geri testi · kaybetti (-1,00R, stop oldu)","04.11.2026 · Hacimli kırılım · kazandı (+0,50R, hedef alındı, kalanı başabaşta kapandı)","28.10.2026 · Hacimli kırılım · kazandı (+1,70R, 3. hedefe ulaştı)","22.09.2026 · Sıkışma kırılımı · kaybetti (-1,00R, stop oldu)","22.09.2026 · Trend içi geri çekilme · kaybetti (-1,00R, stop oldu)","04.09.2026 · Trend içi geri çekilme · kaybetti (-1,00R, stop oldu)","26.08.2026 · Trend içi geri çekilme · kaybetti (-0,39R, süre doldu)","30.07.2026 · Trend içi geri çekilme · başabaş (+0,01R, süre doldu)","İsabet oranı %39, en kötü sonuç -2,09R."]},{"rol":"risk","ad":"Risk yöneticisi","ilke":"En kötü durum rakamla: stop gelirse kayıp, geçmiş en kötü günler (VaR), en büyük düşüş.","bulgular":["Alım pozisyonu için stop 154,87 $ (en yakın destek − 0,5 ATR) gelirse kayıp -%5,0 → 10.000 $'lik pozisyonda ≈ 498 $.","Geçmiş 1 yılın en kötü %5'lik günlerinde kayıp -%6,9 (691 $), en kötü %1'de -%11,2; 10 günlük %5 VaR -%20,3.","Son 1 yılın en kötü günü -%21,0, en büyük düşüş -%31,1.","Piyasa rejimi önerisi: portföyde en çok %30 hisse (Ralli denemesi)."]},{"rol":"denetci","ad":"Gerçeklik denetçisi","ilke":"Varsayılan tutum şüphecilik; çelişki ve veri sorunu varsa güven düşer, kusursuz görünüm kırmızı bayraktır.","bulgular":["Teknik görünüm AL ama piyasa rejimi 'Ralli denemesi'.","Bu varlıkta kurulumların geçmiş ortalaması negatif.","Güven derecesi: Düşük."]}],"risk":{"stop":154.873,"kayip":0.0498005,"sigma_g":0.0509159,"var95":-0.0690777,"var99":-0.112159,"var95_10":-0.202564,"en_kotu_gun":-0.210443,"maks_dusus_1y":-0.31111},"gecmis":{"n":99,"isabet":0.393939,"ort_R":-0.138939,"ga":[-0.358354,0.0804769],"en_kotu":-2.08778,"olaylar":[{"tarih":"2026-07-30 00:00","kurulum":"Trend içi geri çekilme","yon":1,"R":0.00900206,"asama":0,"sebep":"süre"},{"tarih":"2026-08-26 00:00","kurulum":"Trend içi geri çekilme","yon":1,"R":-0.394056,"asama":0,"sebep":"s