7,108.138,108.214,108.284,108.354,108.426,108.507,108.584,108.653]},"gun":{"yuksek":120.44,"dusuk":119.58},"ekip":{"kod":"ED.US","ad":"Consolidated Edison, Inc. Common Stock","fiyat":120.18,"para":"$","gorunum":"AL eğilimli (kanıt zayıf)","guven":"Düşük","ufuk":"Kısa–orta vade (2–6 hafta), günlük ve haftalık grafik","senaryolar":[{"ad":"İyimser","fiyat":126.187,"kosul":"121,91 direnci aşılır, yükseliş sinyalleri teyit edilir","degisim":0.049981},{"ad":"Baz","fiyat":121.682,"kosul":"mevcut görünüm (AL) sürer, fiyat bant içinde hareket eder","degisim":0.0124952},{"ad":"Kötümser","fiyat":114.173,"kosul":"116,82 desteği kırılır, satış baskısı artar","degisim":-0.049981}],"tez_bozucular":["Günlük kapanış 115,72 $ altına inerse (en yakın destek 116,82 kırılır) yükseliş tezi bozulur.","Günlük kapanış 123,00 $ üstüne çıkarsa (direnç 121,91 aşılır) düşüş tezi bozulur.","Haftalık görünüm şu an GÜÇLÜ AL; SAT bölgesine dönerse orta vade tezi değişir.","Piyasa rejimi şu an 'Ralli denemesi'; 'Düzeltme'ye geçerse yeni alımlar için ortam bozulur."],"roller":[{"rol":"arastirmaci","ad":"Yatırım araştırmacısı","ilke":"Boğa ve ayı senaryosu eşit titizlikte; tez ölçülebilir olmalı, tez bozucular önceden yazılır.","bulgular":["Ufuk: Kısa–orta vade (2–6 hafta), günlük ve haftalık grafik.","Boğa tezi: İkili dip – oluşumda.","Ayı tezi: İkili tepe – oluşumda; Negatif uyumsuzluk (RSI); Negatif uyumsuzluk (MACD); MACD sat kesişimi."]},{"rol":"analist","ad":"Finansal analist","ilke":"Önce varsayımlar; tek nokta tahmin yok, baz/iyimser/kötümser senaryo; olgu ile tahmin ayrı.","bulgular":["Varsayımlar: Günlük oynaklık son 1 yılın ortalaması (σ ≈ %1,12) gibi devam eder. 20 işlem günü ufkunda 1 standart sapma bandı kullanılır (%68 olasılık; kesinlik değildir). Destek/direnç geçmiş fiyat yığılmalarından hesaplanır; haber ve bilanço sürprizleri modele dahil değildir.","Senaryolar (20 gün): İyimser 126,19 $ (+%5,0): 121,91 direnci aşılır, yükseliş sinyalleri teyit edilir · Baz 121,68 $ (+%1,2): mevcut görünüm (AL) sürer, fiyat bant içinde hareket eder · Kötümser 114,17 $ (-%5,0): 116,82 desteği kırılır, satış baskısı artar.","Oynaklık %15 yüksek varsayılırsa kötümser senaryo -%5,7 olur; sonuç tablosu bu farka dayanıklı değilse güven düşük okunmalı.","Olgu: son fiyat ve geçmiş göstergeler. Tahmin: senaryo fiyatları — ikisi karıştırılmamalı."]},{"rol":"istatistikci","ad":"İstatistikçi","ilke":"Anlamlılık önem değildir; sonuç aralıkla verilir; az örnek 'bilemiyoruz' demektir; çok deneme yanlış pozitif üretir.","bulgular":["Bu varlığın kendi geçmişinde 95 kurulum olayı (9 farklı kurulum): ortalama -0,08R, %95 güven aralığı [-0,29, +0,12]R; kanıt gücü makul.","Güven aralığı sıfırı kapsıyor: bu varlıkta kurulumların kazandırdığı istatistiksel olarak gösterilemiyor (\"bilemiyoruz\").","Not: 6 gösterge/kurulum birlikte tarandı; tek bir sinyalin öne çıkması şans eseri olabilir. Göstergeler ilişki gösterir, nedensellik değil."]},{"rol":"test","ad":"Test sonuçları analisti","ilke":"Başarısız sinyaller de raporlanır; isabet oranı ve ortalama sonuç birlikte okunur.","bulgular":["Son 8 kurulumun sonucu (kazananlar ve kaybedenler):","08.10.2026 · Pozitif uyumsuzluklu dönüş · kazandı (+1,70R, 3. hedefe ulaştı)","25.09.2026 · Harmonik dönüş · kazandı (+1,70R, 3. hedefe ulaştı)","22.07.2026 · Trend içi geri çekilme · kaybetti (-1,00R, stop oldu)","13.07.2026 · Trend içi geri çekilme · kazandı (+0,50R, hedef alındı, kalanı başabaşta kapandı)","08.05.2026 · Likidite avı dönüşü · kazandı (+0,50R, hedef alındı, kalanı başabaşta kapandı)","17.04.2026 · Likidite avı dönüşü · kaybetti (-1,00R, stop oldu)","09.04.2026 · Trend içi geri çekilme · kaybetti (-1,00R, stop oldu)","26.03.2026 · Trend içi geri çekilme · kazandı (+0,50R, hedef alındı, kalanı başabaşta kapandı)","İsabet oranı %48, en kötü sonuç -1,53R."]},{"rol":"risk","ad":"Risk yöneticisi","ilke":"En kötü durum rakamla: stop gelirse kayıp, geçmiş en kötü günler (VaR), en büyük düşüş.","bulgular":["Alım pozisyonu için stop 115,72 $ (en yakın destek − 0,5 ATR) gelirse kayıp -%3,7 → 10.000 $'lik pozisyonda ≈ 371 $.","Geçmiş 1 yılın en kötü %5'lik günlerinde kayıp -%1,7 (175 $), en kötü %1'de -%2,3; 10 günlük %5 VaR -%5,4.","Son 1 yılın en kötü günü -%2,5, en büyük düşüş -%10,0.","Piyasa rejimi önerisi: portföyde en çok %30 hisse (Ralli denemesi)."]},{"rol":"denetci","ad":"Gerçeklik denetçisi","ilke":"Varsayılan tutum şüphecilik; çelişki ve veri sorunu varsa güven düşer, kusursuz görünüm kırmızı bayraktır.","bulgular":["Teknik görünüm AL ama piyasa rejimi 'Ralli denemesi'.","Bu varlıkta kurulumların geçmiş ortalaması negatif.","Güven derecesi: Düşük."]}],"risk":{"stop":115.725,"kayip":0.0370706,"sigma_g":0.0111761,"var95":-0.0174511,"var99":-0.0229815,"var95_10":-0.0541511,"en_kotu_gun":-0.024711,"maks_dusus_1y":-0.100022},"gecmis":{"n":95,"isabet":0.484211,"ort_R":-0.0829354,"ga":[-0.288732,0.122861],"en_kotu":-1.5266,"olaylar":[{"tarih":"2026-03-26 00:00","kurulum":"Trend içi geri çekilme","yon":1,"R":0.5,"asama":1,"sebep":"başabaş"},{"tarih":"2026-04-09 00:00","kurulum":"Trend içi geri çekilme","yon":1,"R":-1.0,"asama":0,"sebep":"stop"},{"tarih":"2026-04-17 00:00","kurulum":"Likidite avı dönüşü","yon":1,"R":-1.0,"asama":0,"sebep":"stop"},{"tarih":"2026-05-08 00:00","kurulum":"Likidite avı dönüşü","yon":1,"R":0.5,"asama":1,"sebep":"başabaş"},{"tarih":"2026-07-13 00:00","kurulum":"Trend içi geri çekilme","yon":1,"R":0.5,"asama":1,"sebep":"başabaş"},{"tarih":"2026-07-22 00:00","kurulum":"Trend içi geri çekilme","yon":1,"R":-1.0,"asama":0,"sebep":"stop"},{"tarih":"2026-09-25 00:00","kurulum":"Harmonik dönüş","yon":1,"R":1.7,"asama":3,"sebep":"hedef"},{"tarih":"2026-10-08 00:00","kurulum":"Pozitif uyumsuzluklu dönüş","yon":1,"R":1.7,"asama":3,"sebep":"hedef"}],"kurulum_sayisi":9},"ozet":"AL eğilimli (kanıt zayıf) · güven düşük · ufuk 2–6 hafta. Kötümser senaryoda -%5,0, stop gelirse -%3,7.","uyari":"Kural tabanlı otomatik değerlendirmedir; yatırım tavsiyesi değildir."}}