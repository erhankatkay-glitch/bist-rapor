olar":[{"ad":"İyimser","fiyat":302.347,"kosul":"280,91 direnci aşılır, yükseliş sinyalleri teyit edilir","degisim":0.144647},{"ad":"Baz","fiyat":254.588,"kosul":"mevcut görünüm (SAT) sürer, fiyat bant içinde hareket eder","degisim":-0.0361616},{"ad":"Kötümser","fiyat":225.933,"kosul":"252,22 desteği kırılır, satış baskısı artar","degisim":-0.144647}],"tez_bozucular":["Günlük kapanış 243,67 $ altına inerse (en yakın destek 252,22 kırılır) yükseliş tezi bozulur.","Günlük kapanış 289,45 $ üstüne çıkarsa (direnç 280,91 aşılır) düşüş tezi bozulur.","Haftalık görünüm şu an GÜÇLÜ SAT; AL bölgesine dönerse orta vade tezi değişir.","Piyasa rejimi şu an 'Ralli denemesi'; 'Düzeltme'ye geçerse yeni alımlar için ortam bozulur."],"roller":[{"rol":"arastirmaci","ad":"Yatırım araştırmacısı","ilke":"Boğa ve ayı senaryosu eşit titizlikte; tez ölçülebilir olmalı, tez bozucular önceden yazılır.","bulgular":["Ufuk: Kısa–orta vade (2–6 hafta), günlük ve haftalık grafik.","Boğa tezi: Alçalan kama – içinde; Pozitif uyumsuzluk (RSI); Pozitif uyumsuzluk (MACD).","Ayı tezi: Gizli negatif uyumsuzluk (RSI); Sessiz dağıtım."]},{"rol":"analist","ad":"Finansal analist","ilke":"Önce varsayımlar; tek nokta tahmin yok, baz/iyimser/kötümser senaryo; olgu ile tahmin ayrı.","bulgular":["Varsayımlar: Günlük oynaklık son 1 yılın ortalaması (σ ≈ %3,23) gibi devam eder. 20 işlem günü ufkunda 1 standart sapma bandı kullanılır (%68 olasılık; kesinlik değildir). Destek/direnç geçmiş fiyat yığılmalarından hesaplanır; haber ve bilanço sürprizleri modele dahil değildir.","Senaryolar (20 gün): İyimser 302,35 $ (+%14,5): 280,91 direnci aşılır, yükseliş sinyalleri teyit edilir · Baz 254,59 $ (-%3,6): mevcut görünüm (SAT) sürer, fiyat bant içinde hareket eder · Kötümser 225,93 $ (-%14,5): 252,22 desteği kırılır, satış baskısı artar.","Oynaklık %15 yüksek varsayılırsa kötümser senaryo -%16,6 olur; sonuç tablosu bu farka dayanıklı değilse güven düşük okunmalı.","Olgu: son fiyat ve geçmiş göstergeler. Tahmin: senaryo fiyatları — ikisi karıştırılmamalı."]},{"rol":"istatistikci","ad":"İstatistikçi","ilke":"Anlamlılık önem değildir; sonuç aralıkla verilir; az örnek 'bilemiyoruz' demektir; çok deneme yanlış pozitif üretir.","bulgular":["Bu varlığın kendi geçmişinde 149 kurulum olayı (9 farklı kurulum): ortalama +0,19R, %95 güven aralığı [+0,02, +0,37]R; kanıt gücü makul.","Not: 6 gösterge/kurulum birlikte tarandı; tek bir sinyalin öne çıkması şans eseri olabilir. Göstergeler ilişki gösterir, nedensellik değil."]},{"rol":"test","ad":"Test sonuçları analisti","ilke":"Başarısız sinyaller de raporlanır; isabet oranı ve ortalama sonuç birlikte okunur.","bulgular":["Son 8 kurulumun sonucu (kazananlar ve kaybedenler):","09.11.2026 · Pozitif uyumsuzluklu dönüş · kaybetti (-1,02R, stop oldu)","23.10.2026 · Likidite avı dönüşü · kazandı (+0,50R, hedef alındı, kalanı başabaşta kapandı)","15.10.2026 · Likidite avı dönüşü · kaybetti (-2,32R, stop oldu)","30.09.2026 · Likidite avı dönüşü · kaybetti (-1,00R, stop oldu)","04.09.2026 · Harmonik dönüş · kaybetti (-1,00R, stop oldu)","31.08.2026 · Likidite avı dönüşü · kaybetti (-1,00R, stop oldu)","21.07.2026 · Trend içi geri çekilme · kaybetti (-1,00R, stop oldu)","09.06.2026 · Hacimli kırılım · kazandı (+1,47R, süre doldu)","İsabet oranı %59, en kötü sonuç -2,32R."]},{"rol":"risk","ad":"Risk yöneticisi","ilke":"En kötü durum rakamla: stop gelirse kayıp, geçmiş en kötü günler (VaR), en büyük düşüş.","bulgular":["Alım pozisyonu için stop 243,67 $ (en yakın destek − 0,5 ATR) gelirse kayıp -%7,7 → 10.000 $'lik pozisyonda ≈ 775 $.","Geçmiş 1 yılın en kötü %5'lik günlerinde kayıp -%4,7 (473 $), en kötü %1'de -%6,3; 10 günlük %5 VaR -%14,2.","Son 1 yılın en kötü günü -%20,6, en büyük düşüş -%58,9.","Piyasa rejimi önerisi: portföyde en çok %30 hisse (Ralli denemesi)."]},{"rol":"denetci","ad":"Gerçeklik denetçisi","ilke":"Varsayılan tutum şüphecilik; çelişki ve veri sorunu varsa güven düşer, kusursuz görünüm kırmızı bayraktır.","bulgular":["Belirgin çelişki b